# ZeroDrop Terminal Environment Configuration
# Copy this file to .env and update with your values
# NEVER commit .env to version control

# Printer Configuration
# Printer type: "mock" for testing, "usb" for production
PRINTER_TYPE=mock

# USB device path (required if PRINTER_TYPE=usb)
# Common paths: /dev/usb/lp0, /dev/usb/lp1, /dev/usblp0
# Leave empty for auto-detection
# PRINTER_DEVICE=/dev/usb/lp0

# Raw USB device path (for printers without usblp driver support, e.g. Zjiang 0fe6:811e)
# Set automatically by setup-printer.sh when raw USB mode is detected
# Docker: docker-compose.prod.yml mounts /dev/bus/usb and /sys/bus/usb automatically
# USB_RAW_DEVICE=/dev/bus/usb/001/090

# Public Key Configuration
# Path where the public key PEM file will be saved
PUBLIC_KEY_PATH=./public_key.pem

# Rate Limiting Configuration
# Maximum requests per IP per hour (default: 5)
# Note: The app includes basic built-in rate limiting. For production,
# deploy behind a reverse proxy (nginx, caddy, etc.) for TLS termination,
# advanced rate limiting, and security hardening.
# RATE_LIMIT_REQUESTS_PER_HOUR=5

# Burst capacity for rate limiting (default: 1)
# RATE_LIMIT_BURST=1

# Logging Configuration
# Enable structured JSON logging (default: false)
# When enabled, logs include timestamps, IPs, and request metadata
# LOG_ENABLED=false

# TLS Configuration
# Controls whether ZeroDrop serves HTTPS with a built-in self-signed certificate.
#
# Set to "false" (default) when:
#   - Accessing from localhost only (browser treats localhost as secure context)
#   - Deploying behind a reverse proxy (Traefik, nginx, caddy) — the proxy handles TLS
#
# Set to "true" when:
#   - Accessing directly from other devices on your network WITHOUT a reverse proxy
#   - Web Crypto API requires a secure context (HTTPS or localhost)
#   - The server generates a self-signed ECDSA P-256 cert at startup
#   - Browsers will show a security warning — click Advanced → Proceed to site
# TLS_ENABLED=true
