# ZeroDrop Terminal v1.0 — Production Deployment Makefile
# Operations-focused targets for Docker-only production deployment

.PHONY: help deploy deploy-update deploy-rollback
.PHONY: build-docker
.PHONY: run-docker stop-docker restart-docker
.PHONY: health health-detailed status logs logs-docker
.PHONY: backup-key restore-key backup-config restore-config
.PHONY: check-secure update-deps scan-vulns setup-udev

help:
	@echo "ZeroDrop Terminal v1.0 — Production Deployment (Docker)"
	@echo ""
	@echo "Quick Deploy:"
	@echo "  make deploy              - Full production deployment (Docker)"
	@echo ""
	@echo "Build:"
	@echo "  make build-docker        - Build Docker images"
	@echo ""
	@echo "Run/Stop:"
	@echo "  make run-docker          - Run with Docker Compose"
	@echo "  make stop-docker         - Stop Docker services"
	@echo "  make restart-docker      - Restart Docker services"
	@echo ""
	@echo "Health & Status:"
	@echo "  make health               - Quick health check"
	@echo "  make health-detailed     - Detailed health with printer status"
	@echo "  make status               - Show service status"
	@echo "  make logs                - Show service logs"
	@echo "  make logs-docker         - Show Docker logs"
	@echo ""
	@echo "Backup & Restore:"
	@echo "  make backup-key          - Backup public key"
	@echo "  make restore-key         - Restore public key from backup"
	@echo "  make backup-config       - Backup configuration"
	@echo "  make restore-config      - Restore configuration"
	@echo ""
	@echo "Printer Setup:"
	@echo "  make setup-udev          - Generate udev rules for USB printer access"
	@echo "  make setup-user-groups   - Add current user to lp/dialout groups"
	@echo ""
	@echo "Security:"
	@echo "  make check-secure        - Run security checks"
	@echo "  make update-deps         - Update and audit dependencies"
	@echo "  make scan-vulns          - Scan for vulnerabilities"
	@echo ""

# =============================================================================
# Configuration
# =============================================================================

BUILD_DIR=bin
FRONTEND_DIR=frontend
FRONTEND_DIST=$(FRONTEND_DIR)/dist
PUBLIC_KEY_PATH=./data/public_key.pem
CONFIG_FILE=./data/config.env
BACKUP_DIR=./data/backups
DOCKER_COMPOSE=docker compose
TIMESTAMP=$(shell date +%Y%m%d_%H%M%S)

# Production defaults (can be overridden)
PRINTER_TYPE?=usb
PRINTER_DEVICE?=
LOG_ENABLED?=false

# =============================================================================
# Deployment Targets
# =============================================================================

deploy: check-secure build-docker run-docker
	@echo "✓ ZeroDrop Terminal deployed successfully"
	@echo "  Access: http://localhost:8080"
	@echo "  Health: make health"
	@echo "  Logs:   make logs-docker"

deploy-update: backup-key backup-config
	@echo "→ Updating ZeroDrop Terminal..."
	@$(MAKE) deploy
	@echo "✓ Update complete"
	@echo "  Backups saved to $(BACKUP_DIR)"

deploy-rollback:
	@echo "→ Rolling back to previous Docker image..."
	@$(MAKE) stop-docker
	@$(MAKE) run-docker
	@echo "✓ Rollback complete"

# =============================================================================
# Build Targets
# =============================================================================

build-docker:
	@echo "→ Building Docker images..."
	@$(DOCKER_COMPOSE) -f docker-compose.yml -f docker-compose.prod.yml build
	@echo "✓ Docker images built"

# =============================================================================
# Run/Stop Targets
# =============================================================================

run-docker:
	@echo "→ Starting ZeroDrop Terminal (Docker mode)..."
	@$(DOCKER_COMPOSE) -f docker-compose.yml -f docker-compose.prod.yml up -d
	@echo "✓ Docker services running"
	@sleep 2
	@$(MAKE) health

stop-docker:
	@echo "→ Stopping Docker services..."
	@$(DOCKER_COMPOSE) -f docker-compose.yml -f docker-compose.prod.yml down
	@echo "✓ Docker services stopped"

restart-docker: stop-docker run-docker
	@echo "✓ Docker services restarted"

# =============================================================================
# Health & Status Targets
# =============================================================================

health:
	@echo "→ Health check..."
	@curl -sf http://localhost:8080/health || (echo "✗ Service unhealthy" && exit 1)
	@echo "✓ Service healthy"

health-detailed:
	@echo "→ Detailed health check..."
	@curl -sf http://localhost:8080/health 2>/dev/null | jq . || echo "✗ Health check failed"

status:
	@echo "→ Service Status:"
	@echo "  Public key: $$(test -f $(PUBLIC_KEY_PATH) && echo 'yes' || echo 'no')"
	@echo ""
	@echo "→ Running services:"
	@docker ps --format '{{.Names}}' 2>/dev/null | grep -q zerodrop && echo "  Docker: running" || echo "  Docker: stopped"

logs:
	@echo "→ Service logs (last 50 lines):"
	@if [ -f zerodrop.log ]; then \
		tail -50 zerodrop.log; \
	else \
		echo "  No log file found"; \
	fi

logs-docker:
	@echo "→ Docker logs (last 50 lines):"
	@$(DOCKER_COMPOSE) logs --tail=50 -f

# =============================================================================
# Backup & Restore Targets
# =============================================================================

backup-key:
	@echo "→ Backing up public key..."
	@mkdir -p $(BACKUP_DIR)
	@if [ -f $(PUBLIC_KEY_PATH) ]; then \
		cp $(PUBLIC_KEY_PATH) $(BACKUP_DIR)/public_key.pem.$(TIMESTAMP); \
		cp $(PUBLIC_KEY_PATH) $(BACKUP_DIR)/public_key.pem.backup; \
		echo "✓ Public key backed up to $(BACKUP_DIR)"; \
	else \
		echo "✗ Public key not found"; \
	fi

restore-key:
	@echo "→ Restoring public key..."
	@if [ -f $(BACKUP_DIR)/public_key.pem.backup ]; then \
		cp $(BACKUP_DIR)/public_key.pem.backup $(PUBLIC_KEY_PATH); \
		echo "✓ Public key restored"; \
	else \
		echo "✗ Backup not found"; \
	fi

backup-config:
	@echo "→ Backing up configuration..."
	@mkdir -p $(BACKUP_DIR)
	@tar -czf $(BACKUP_DIR)/config.$(TIMESTAMP).tar.gz data/ 2>/dev/null || echo "  No data directory to backup"
	@echo "✓ Configuration backed up to $(BACKUP_DIR)"

restore-config:
	@echo "→ Restoring configuration..."
	@echo "  Available backups:"
	@ls -lt $(BACKUP_DIR)/config.*.tar.gz 2>/dev/null || echo "  No backups found"
	@echo "  To restore: tar -xzf <backup-file> -C ."

# =============================================================================
# Security Targets
# =============================================================================

check-secure:
	@echo "→ Running security checks..."
	@echo "  Go vet..."
	@go vet ./... || (echo "✗ Go vet failed" && exit 1)
	@echo "  govulncheck..."
	@govulncheck ./... || (echo "✗ Vulnerabilities found" && exit 1)
	@echo "  Test with race detection..."
	@go test ./... -race -short || (echo "✗ Race conditions found" && exit 1)
	@echo "✓ All security checks passed"

update-deps:
	@echo "→ Updating dependencies..."
	@go get -u ./...
	@go mod tidy
	@echo "  Frontend dependencies..."
	cd $(FRONTEND_DIR) && npm update
	cd $(FRONTEND_DIR) && npm audit fix
	@echo "✓ Dependencies updated"

scan-vulns:
	@echo "→ Scanning for vulnerabilities..."
	@govulncheck ./...
	@cd $(FRONTEND_DIR) && npm audit
	@echo "✓ Vulnerability scan complete"

# =============================================================================
# Printer Setup Targets
# =============================================================================

# Run the full printer setup script: detects hardware, adds groups,
# generates and installs udev rules, configures .env, and verifies
# write access. Safe to run multiple times — skips already-done steps.
# To preview without making changes: ./scripts/setup-printer.sh --dry-run
setup-printer:
	@echo "→ Running full printer setup..."
	@./scripts/setup-printer.sh

setup-udev:
	@echo "→ This target is now part of the unified setup script."
	@echo "  Run: make setup-printer"
	@echo "  Or:  ./scripts/setup-printer.sh"
	@echo ""

setup-user-groups:
	@echo "→ This target is now part of the unified setup script."
	@echo "  Run: make setup-printer"
	@echo "  Or:  ./scripts/setup-printer.sh"
	@echo ""
